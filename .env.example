# Optional development override. By default, the app uses the browser or Expo
# development host with port 8000. For a physical phone, set this to the
# development computer's LAN URL, for example http://192.168.1.20:8000.
# Production builds must set this to the HTTPS API origin before building.
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Local Docker PostgreSQL only. Set a unique value in the ignored root .env
# before starting infra/docker-compose.yml; an empty value is rejected.
POSTGRES_PASSWORD=
